<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same secrets store as D1-D4 so NVIDIA_API_KEY resolves here too. -->
    <UserSecretsId>428e8166-f271-4d1d-899a-93932b11efbb</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse D2's embed/retrieve/chat (which chains to D1). D3 supplies the naive
         char-count chunker as the "wrong way" baseline. D5 only adds the semantic
         chunker and the eval sweep. -->
    <ProjectReference Include="../02-rag-by-hand/D2.csproj" />
    <ProjectReference Include="../03-break-it-on-purpose/D3.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
  </ItemGroup>
</Project>
